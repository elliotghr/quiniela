#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://192.168.5.132:8444/'
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false
app.appLocale = 'es_MX'
app.appTimezone = 'America/Mexico_City'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 192.168.5.132
database.default.database = quinieland_development
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3396

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key = 
encryption.driver = OpenSSL
encryption.blockSize = 32
encryption.digest = SHA512

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null
session.cookieName = 'quinieland-session'
session.expiration = 864000

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# Custom
#--------------------------------------------------------------------

registro.modulo = false
registro.defaultRolId = 2
theme.icon = 'fas fa-futbol'
theme.logo = true

reCaptchaV2.active = false
reCaptchaV2.api = https://www.google.com/recaptcha/api/siteverify
reCaptchaV2.public =
reCaptchaV2.secret =

reCaptchaV3.active = false
reCaptchaV3.api = https://www.google.com/recaptcha/api/siteverify
reCaptchaV3.public =
reCaptchaV3.secret =

# Enlistar los controladores que NO requieren autenticacion, separados por pipes
openControllers = ParticipantsController

# Enlistar los controladores que SI requieren autenticacion pero son accesibles para todos, separados por pipes
fullAccessControllers = FileSystemController

# Temporada de la quiniela
quiniela.season = 2026
quiniela.refresh = 5
quiniela.home.mostrar = 3

#--------------------------------------------------------------------
# MAILCHIMP
#--------------------------------------------------------------------
# The enviroment has two options production or test

mailchimp.enviroment = production
mailchimp.production.key =
mailchimp.test.key =
mailchimp.default.email = no-reply@quinieland.com
mailchimp.default.fromName = "Quinieland"

