FROM php:8.3-apache

# ACTUALIZAR EL SISTEMA E INSTALAR DEPENDENCIAS
RUN apt-get update \
    && apt-get install -y \
        unzip \
        libicu-dev \
        tzdata \
    && docker-php-ext-configure intl \
    && docker-php-ext-install intl mysqli \
    && rm -rf /var/lib/apt/lists/*

# CONFIGURACIÓN DE ZONA HORARIA
ENV TZ=America/Mexico_City

# CONFIGURACIÓN PHP
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# DOCUMENT ROOT DE APACHE
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public

RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
    /etc/apache2/sites-available/*.conf \
    /etc/apache2/apache2.conf

# CONFIGURAR APACHE
RUN a2dismod mpm_event mpm_worker mpm_prefork 2>/dev/null || true \
    && a2enmod mpm_prefork rewrite

# OCULTAR VERSIÓN DE PHP
RUN echo "expose_php=Off" > /usr/local/etc/php/conf.d/security.ini

# INSTALAR COMPOSER
WORKDIR /var/www/html

RUN curl -sS https://getcomposer.org/installer \
    | php -- --install-dir=/usr/local/bin --filename=composer

# CONFIGURAR SCRIPT DE INICIO
RUN mkdir -p /utils/scripts

COPY ./ms-start.sh /utils/scripts/ms-start.sh

RUN chmod +x /utils/scripts/ms-start.sh

# COPIAR PROYECTO
COPY ./codeigniter/ /var/www/html/

# PERMISOS DE CODEIGNITER
RUN chown -R www-data:www-data /var/www/html/writable

WORKDIR /var/www/html

ENTRYPOINT ["bash", "/utils/scripts/ms-start.sh"]