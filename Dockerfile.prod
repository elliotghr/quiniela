FROM php:8.3-apache

# ==========================================
# ACTUALIZAR SISTEMA
# ==========================================

RUN apt-get update


# ==========================================
# INSTALAR DEPENDENCIAS DE CODEIGNITER 4
# ==========================================

RUN apt-get install -y \
        unzip \
        libicu-dev \
        tzdata \
        npm \
    && docker-php-ext-configure intl \
    && docker-php-ext-install intl mysqli \
    && rm -rf /var/lib/apt/lists/*


# ==========================================
# ZONA HORARIA
# ==========================================

ENV TZ=America/Mexico_City


# ==========================================
# CONFIGURACIÓN PHP
# ==========================================

RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

RUN echo "expose_php=Off" \
    > /usr/local/etc/php/conf.d/security.ini


# ==========================================
# CONFIGURAR APACHE
# ==========================================

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public

RUN sed -ri \
    -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
    /etc/apache2/sites-available/*.conf


# Deshabilitar cualquier MPM adicional
# y dejar únicamente mpm_prefork
RUN a2dismod mpm_event mpm_worker mpm_prefork || true \
    && a2enmod mpm_prefork \
    && a2enmod rewrite


# ==========================================
# INSTALAR COMPOSER
# ==========================================

WORKDIR /var/www/html

RUN curl -sS https://getcomposer.org/installer \
    | php -- \
    --install-dir=/usr/local/bin \
    --filename=composer


# ==========================================
# COPIAR PROYECTO CODEIGNITER
# ==========================================

COPY ./codeigniter/ /var/www/html/


# ==========================================
# INSTALAR DEPENDENCIAS PHP
# ==========================================

RUN composer install --no-dev --optimize-autoloader


# ==========================================
# INSTALAR SASS
# ==========================================

RUN npm install -g sass


# ==========================================
# INSTALAR DEPENDENCIAS NPM
# ==========================================

WORKDIR /var/www/html/public

RUN npm install


# ==========================================
# COMPILAR SASS
# ==========================================

RUN sass \
    /var/www/html/public/css/custom-bootstrap.scss \
    /var/www/html/public/css/custom-bootstrap.css


# ==========================================
# PERMISOS DE CODEIGNITER
# ==========================================

RUN chmod -R 777 /var/www/html/writable


# ==========================================
# SCRIPT DE INICIO
# ==========================================

RUN mkdir -p /utils/scripts

COPY ./ms-start.sh /utils/scripts/ms-start.sh

RUN chmod +x /utils/scripts/ms-start.sh


# ==========================================
# DIRECTORIO DE TRABAJO
# ==========================================

WORKDIR /var/www/html


# ==========================================
# INICIAR CONTENEDOR
# ==========================================

ENTRYPOINT ["bash", "/utils/scripts/ms-start.sh"]